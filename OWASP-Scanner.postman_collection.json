                  "    if (server) {\r",
                  "        console.log(\"CRITICAL: Server header exposed: \" + server);\r",
                  "    }\r",
                  "    pm.expect(server).to.not.be.undefined;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"API8: X-Powered-By header not exposed\", function () {\r",
                  "    pm.expect(pm.response.headers.get(\"X-Powered-By\")).to.be.undefined;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"API8: X-Content-Type-Options header present\", function () {\r",
                  "    pm.expect(pm.response.headers.get(\"X-Content-Type-Options\")).to.equal(\"nosniff\");\r",
