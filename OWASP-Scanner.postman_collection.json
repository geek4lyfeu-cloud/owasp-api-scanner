                  "pm.test(\"BOLA VULNERABILITY FOUND - User Two location exposed to User One\", function () {\r",
                  "    if (pm.response.code === 200) {\r",
                  "        const body = pm.response.json();\r",
                  "        console.log(\"CRITICAL: User One accessed User Two location!\");\r",
                  "        console.log(\"Exposed location: \" + JSON.stringify(body.vehicleLocation));\r",
                  "        pm.expect(pm.response.code).to.equal(200); // Documents the vulnerability\r",
