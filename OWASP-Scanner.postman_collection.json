        {
          "name": "BOLA - Access Another User's Data",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// User One is logged in but we'll try to access User Two's vehicle\r",
                  "console.log(\"Attempting BOLA attack - User One accessing User Two's data\");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"BOLA: Check if other user data is accessible\", function () {\r",
                  "    const bodyText = pm.response.text();\r",
                  "    pm.expect(bodyText).to.not.include(\"usertwo@test.com\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userOne_token}}",
                  "type": "string"
